{
  "ConnectionStrings": {
    "DefaultConnection": "server=mysql-local.church-dev.svc.cluster.local;database=db_object;user=;password=;port=3306;SslMode=None;",
    "FileJobs": "server=mysql-local.church-dev.svc.cluster.local;database=db_object;user=;password=;port=3306;SslMode=None;"
  },
  "Swagger": {
    "Version": "v1",
    "Title": "Church San Luis - API de objetos",
    "Description": "Mantenimiento de objetos"
  },
  "MinIo": {
    "Endpoint": "minio-api.ropabajo.pe",
    "AccessKey": "",
    "SecretKey": "",
    "UseSsl": true,
    "BucketName": "church-dev"
  },
  "RabbitMq": {
    "HostName": "rabbitmq-shared.church-dev.svc.cluster.local",
    "Port": 5672,
    "VirtualHost": "local-vhost",
    "UseSsl": false,
    "UserName": "",
    "Password": ""
  },
  "Keycloak": {
    "Authority": "https://auth-dev.idnsanluis.org/realms/church",
    "Audience": "account",
    "AuthorizedParty": "web-ap-container",
    "RoleClient": "web-ap-container",
    "Enabled": true,
    "RequireHttpsMetadata": true,
    "DisabledUserId": "keycloak-disabled",
    "DisabledUsername": "keycloak-disabled",
    "DisabledRoles": [
      "ADMIN",
      "USER_ADMIN"
    ]
  },
  "Redis": {
    "Host": "redis-shared.church-dev.svc.cluster.local",
    "Port": 6379,
    "User": "msa-iam",
    "Password": "",
    "Database": 1,
    "Ssl": false
  },
  "spring": {
    "cloud": {
      "config": {
        "enabled": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Ropabajo.Churc.Sanluis.Framework.Integration.IntegrationCleanup": "Information"
    }
  },
  "AllowedHosts": "*",
  "Base": {
    "Path": ""
  },
  "FileJobs": {
    "Enabled": true,
    "Environment": "development",
    "WorkerAudience": "objects-files",
    "WorkerClients": {
      "msa-church-file-worker": "church"
    },
    "LeaseSeconds": 120,
    "RunSeconds": 900,
    "JobDeadlineSeconds": 3600,
    "LinkSeconds": 900,
    "UploadSeconds": 600,
    "RetentionHours": 24,
    "ReuseSeconds": 300,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 30,
    "MaxBytes": 20971520,
    "MaxActivePerOwner": 3,
    "PollSeconds": 5,
    "BatchSize": 25
  }
}
